# Parallelization
Partition :	2 2 1

Lx :	10
Ly :	20
Lz :	10
nx :	128
ny :	256
nz :	1

# Case parameters
Droplet center : 0 18 0
Pool depth : 4

# Method type
Method type : 1 ! 1 is the momentum flux, 2 is the centered
Falling Drop Activated: .true.
Surface tension Activated: .true.
Implicit: .true.


# Fluid properties
Gravity :           0.0 -1.0 0.0
Liquid density :    1000.0
Gas density :       1.0
Liquid dynamic viscosity : 0.01
Gas dynamic viscosity :    0.00001
Surface tension coefficient : 1000.0

# SGS modeling
Use SGS model : .false.!.true.

# Time integration
Max timestep size : 5e-3
Max cfl number :    0.9
Max time :          8

# Pressure solver
Pressure tolerance : 1e-5
Pressure iteration : 100

# Ensight output
Ensight output period : 5e-1