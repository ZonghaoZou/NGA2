#!/bin/bash
#SBATCH -p normal
#SBATCH -t 120:00:00
#SBATCH --nodes=2
#SBATCH --ntasks-per-node=12
#SBATCH --exclude=c-3-[13,15]
#SBATCH --exclusive
#SBATCH -J VTG20sub
#SBATCH -o %j.out
#SBATCH -e %j.err
