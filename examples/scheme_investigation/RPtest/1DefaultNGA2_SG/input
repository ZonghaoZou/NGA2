# Mesh definition
# Lx must equal 2*pi / wavenumber for periodicity
# For R0=1.0 and optimal k=0.7, Lx approx 8.976

# Parallelization
Partition :	2 2 1

Lx :    10.0
Ly :    10.0
Lz :    10.0
nx :    64
ny :    64
nz :    64

# Case parameters (These keys must match your simulation_init param_read calls)
Cylinder radius :      1.0
Perturbation epsilon : 0.05
Wavenumber :           10

# Fluid properties (Keep density ratio low/moderate for initial validation)
Gravity :                     0 0 0
Liquid dynamic viscosity :    1.0e-2
Gas dynamic viscosity :       1.0e-4
Liquid density :              1.0
Gas density :                 0.01
Surface tension coefficient : 1.0

# Time integration (Breakup happens around t=15-20 for these params)
Max timestep size : 1.5e-2
Max cfl number :    0.9
Max time :          15.0

# Pressure solver
Pressure tolerance : 1e-6
Pressure iteration : 100

# Ensight output
Ensight output period : 2.0e-1